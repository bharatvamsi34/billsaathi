# BillSaathi API configuration.
# Copy to api/.env and fill in locally. api/.env is gitignored — never commit real values.
# This file lists variable NAMES only.

# --- Meta Model API (dev.meta.ai) ---
META_API_KEY=
META_API_BASE_URL=
META_MODEL_SPARK=
META_MODEL_WONDER=
META_MODEL_SAM=
META_MODEL_TRANSCRIBE=

# --- Baseten (open-weight Muse Spark Open, OpenAI-compatible) ---
BASETEN_API_KEY=
BASETEN_BASE_URL=
BASETEN_MODEL=

# --- App ---
APP_ENV=
LOG_LEVEL=

# --- Checks API (defaults in app/config.py) ---
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=
DAILY_SPEND_CAP_USD=
CHECK_TTL_SECONDS=
MODEL_TIMEOUT_SECONDS=
